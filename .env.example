# Public base URL of the shiur site (used in the feed, sitemap and structured data)
SITE_URL=https://ein-yaakov.vercel.app
# Public base URL of the R2 bucket holding published MP3s, no trailing slash.
# Files are expected at <AUDIO_BASE_URL>/<masechta>/<Masechta-NN>.mp3
AUDIO_BASE_URL=
# Set to 1 to prefix feed enclosure URLs with OP3 for download stats
OP3=0
# Podcast owner contact, required by Apple Podcasts
PODCAST_OWNER_NAME=
PODCAST_OWNER_EMAIL=
